# Copy to .env and edit. `make serve` exports these; nothing else reads .env. Never commit .env.
BEHAVLAB_HOST=127.0.0.1
BEHAVLAB_PORT=8000
# Bearer token. When set, every /api route except /api/health needs it. A non-loopback host requires it.
BEHAVLAB_API_TOKEN=
# Requests per second per client before the API answers 429.
BEHAVLAB_RATE_PER_SEC=30
# Limit runs to the first N people (smoke checks only; reported results use all 60).
BEHAVLAB_USERS=
